# Add these values to your hosting provider's secret/environment settings.
# Do not commit real API keys. The repository's .env file is ignored by Git.
# If provider keys are absent, text/image AI commands use anonymous AI Horde.
# Prompts go to volunteer workers; anonymous generated images are shared with LAION.
# .sora video still requires GEMINI_API_KEY or GOOGLE_API_KEY.
OPENAI_API_KEY=
GEMINI_API_KEY=
BFL_API_KEY=

# Optional model overrides; defaults are shown.
OPENAI_TEXT_MODEL=gpt-6.1-terra
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
BFL_FLUX_MODEL=flux-2-pro
